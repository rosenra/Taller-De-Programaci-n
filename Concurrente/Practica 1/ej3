programa ej3
procesos
  proceso juntarFlores (ES flores:numero)
  variables
    aux:numero
  comenzar
    aux:=0
    mientras(HayFlorEnLaEsquina)
      tomarFlor
      flores:=flores+1
      aux:=aux+1
    repetir aux
      depositarFlor
  fin
  proceso juntarPapeles (ES papeles:numero)
  variables
    aux:numero
  comenzar
    aux:=0
    mientras (HayPapelEnLaEsquina)
      tomarPapel
      papeles:=papeles+1
      aux:=aux+1
    repetir aux
      depositarPapel
  fin
  proceso escalon(ES flores:numero;ES papeles: numero;E pasos:numero)
  comenzar
    repetir 2
      repetir pasos
        juntarFlores(flores)
        juntarPapeles(papeles)
        mover
      derecha
    repetir 2
      derecha
  fin
  proceso escalera (ES cant:numero)
  variables
    flores,papeles,pasos:numero{pasos va en var o es ES}
  comenzar
    pasos:=1
    repetir 4
      flores:=0
      papeles:=0
      escalon(flores,papeles,pasos)
      si (papeles-flores=1)
        cant:=cant+1
      pasos:=pasos+1
  fin
  areas 
    area1: AreaP(1,1,100,100)
  robots
    robot tipo1
    variables
      cant:numero
    comenzar
      cant:=0
      escalera(cant)
      informar(cant)
    fin
  variables
   r1,r2,r3: tipo1
  comenzar
    AsignarArea(r1,area1)
    AsignarArea(r2,area1)
    AsignarArea(r3,area1)
    Iniciar(r1,12,14)
    Iniciar(r2,17,10)
    Iniciar(r3,22,6)
  fin