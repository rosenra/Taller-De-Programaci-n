programa ej3p3
procesos
  proceso juntarFlores (ES flores:numero; E x:numero;E y:numero)
  variables
    AvInicial,CaInicial:numero
  comenzar
    AvInicial:=PosAv
    CaInicial:=PosCa
    flores:=0
    BloquearEsquina(x,y)
    Pos(x,y)
    mientras (HayFlorEnLaEsquina)
      tomarFlor
      flores:=flores+1
      Pos(AvInicial,CaInicial)
      LiberarEsquina(x,y)
      BloquearEsquina(x,y)
      Pos(x,y)
    Pos(AvInicial,CaInicial)
    LiberarEsquina(x,y)
  fin
  proceso enviarMSJ(E x:numero;E y:numero)
  comenzar
    EnviarMensaje(x,r1)
    EnviarMensaje(y,r1)
    EnviarMensaje(x,r2)
    EnviarMensaje(y,r2)
    EnviarMensaje(x,r3)
    EnviarMensaje(y,r3)
    EnviarMensaje(x,r4)
    EnviarMensaje(y,r4)
  fin
  proceso IDs
  comenzar
    EnviarMensaje(1,r1)
    EnviarMensaje(2,r2)
    EnviarMensaje(3,r3)
    EnviarMensaje(4,r4)
  fin
  proceso maximo (E flores:numero;ES max:numero;ES idMax:numero;E id:numero)
  comenzar
    si (flores> max)
      max:=flores
      idMax:=id
  fin
areas
  area1: AreaP(2,1,2,1)
  area2: AreaP(3,1,3,1)
  area3: AreaP(4,1,4,1)
  area4: AreaP(5,1,5,1)
  cuadrado: AreaC(2,2,10,10)
  areaJ: AreaP(1,1,1,1)
robots
  robot tipo1
  variables
    flores:numero
    id:numero
    x:numero
    y:numero
  comenzar
    RecibirMensaje(id,rJ)
    RecibirMensaje(x,rJ)
    RecibirMensaje(y,rJ)
    juntarFlores(flores,x,y)
    EnviarMensaje(id,rJ)
    EnviarMensaje(flores,rJ)
  fin
  robot jefe
  variables
    id:numero
    x,y:numero
    f:numero
    max:numero
    maxID:numero
  comenzar
    IDs
    Random(x,2,10)
    Random(y,2,10)
    enviarMSJ(x,y)
    max:=-1
    repetir 4
      RecibirMensaje(id,*)
      si (id=1)
        RecibirMensaje(f,r1)
      sino
        si (id=2)
          RecibirMensaje(f,r2)
        sino
          si(id=3)
            RecibirMensaje(f,r3)
          sino
            RecibirMensaje(f,r4)
      maximo(f,max,maxID,id)
    Informar(maxID)
  fin
variables
  r1,r2,r3,r4:tipo1
  rJ:jefe
comenzar
  AsignarArea(r1,area1)
  AsignarArea(r2,area2)
  AsignarArea(r3,area3)
  AsignarArea(r4,area4)
  AsignarArea(r1,cuadrado)
  AsignarArea(r2,cuadrado)
  AsignarArea(r3,cuadrado)
  AsignarArea(r4,cuadrado)
  AsignarArea(rJ,areaJ)
  Iniciar(r1,2,1)
  Iniciar(r2,3,1)
  Iniciar(r3,4,1)
  Iniciar(r4,5,1)
  Iniciar(rJ,1,1)
fin