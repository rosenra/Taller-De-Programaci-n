  AsignarArea(r4,area4)
  AsignarArea(rJ,areaJ)
  AsignarArea(r1,diez)
  AsignarArea(r1,once)
  AsignarArea(r2,diez)
  AsignarArea(r2,once)
  AsignarArea(r3,diez)
  AsignarArea(r3,once)
  AsignarArea(r4,diez)
  AsignarArea(r4,once)
  AsignarArea(rJ,diez)
