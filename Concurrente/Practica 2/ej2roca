programa ej4
procesos
  proceso juntarFloresEsq
  comenzar
    mientras (HayFlorEnLaEsquina)
      tomarFlor
  fin
  proceso juntarPapelesEsq
  comenzar
    mientras (HayPapelEnLaEsquina)
      tomarPapel
  fin
  proceso floresAv
  variables
    av:numero
  comenzar
    av:=PosAv
    repetir 24
      repetir 99
        si (HayFlorEnLaEsquina)
          juntarFloresEsq
        mover
      juntarFloresEsq
      av:= av+1
      Pos(av,1)
    repetir 99
      juntarPapelesEsq
      mover
    juntarPapelesEsq  
  fin
  proceso papelesAv
  variables
    av:numero
  comenzar
    av:=PosAv
    repetir 24
      repetir 99
        juntarPapelesEsq
        mover
      juntarPapelesEsq
      av:= av+1
      Pos(av,1)
    repetir 99
      juntarPapelesEsq
      mover
    juntarPapelesEsq  
  fin   
areas
