programa ej2_p2
procesos
  proceso izquierda
  comenzar
    repetir 3
      derecha
  fin
  proceso juntarFlores(ES flores:numero)
  comenzar
    mientras (HayFlorEnLaEsquina)
      tomarFlor
      flores:=flores+1
  fin
  proceso juntarPapeles(ES papeles:numero)
  comenzar
    mientras(HayPapelEnLaEsquina)
      tomarPapel
      papeles:=papeles+1
  fin
  proceso escalon(ES cant:numero;E alto:numero)
  variables
    flores,papeles:numero
  comenzar
    flores:=0
    papeles:=0
    repetir alto
      si (HayFlorEnLaEsquina)
        juntarFlores(flores)
      si(HayPapelEnLaEsquina)
        juntarPapeles(papeles)
      mover
    si (HayFlorEnLaEsquina)
      juntarFlores(flores)
    si(HayPapelEnLaEsquina)
      juntarPapeles(papeles) 
    derecha
    mover
    izquierda
    si (flores> papeles)
      cant:=cant+1
  fin
areas
  area1: AreaP(2,1,100,100)
  areaJ: AreaP(1,1,1,1)
robots
  robot tipo1
  variables
    cant,alto:numero
  comenzar
    cant:=0
    Random(alto,1,5)
    escalon(cant,alto)
    EnviarMensaje(cant,rJ)
  fin
  robot jefe
  variables
    suma,cant:numero
  comenzar
    suma:=0
    repetir 3
      RecibirMensaje(cant,*)
      suma:=suma+cant
    Informar('suma',suma)
  fin
variables
  r1,r2,r3:tipo1
  rJ:jefe
comenzar
  AsignarArea(r1,area1)
  AsignarArea(r2,area1)
  AsignarArea(r3,area1)
  AsignarArea(rJ,areaJ)
  Iniciar(r1,2,1)
  Iniciar(r2,7,1)
  Iniciar(r3,12,1)
  Iniciar(rJ,1,1)
fin