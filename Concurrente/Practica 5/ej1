{modularizo los robots rojo y azul???}
programa ej1p5
procesos
  proceso IDs
  comenzar
    EnviarMensaje(1,r1)
    EnviarMensaje(2,r2)
    EnviarMensaje(3,a1)
    EnviarMensaje(4,a2)
  fin
  proceso juntarF (ES flores:numero)
  comenzar
    mientras(HayFlorEnLaEsquina)
      tomarFlor
      flores:=flores+1
  fin
  proceso juntarP (ES papeles:numero)
  comenzar
    mientras (HayPapelEnLaEsquina)
      tomarPapel
      papeles:=papeles+1
  fin
areas
  areaR1: AreaP(2,1,2,97)
  areaR1B: AreaP(2,100,2,100)
  areaR2: AreaP(3,1,3,97)
  areaR2B: AreaP(3,100,3,100)
  areaA1: AreaP(1,98,1,98)
  areaA1B: AreaP(4,98,100,98)
  areaA2: AreaP(1,99,1,99)
  areaA2B: AreaP(4,99,100,99)
  esquina1: AreaPC(2,98,2,99)
  esquina2: AreaPC(3,98,3,99)
  areaF: AreaP(1,1,1,1)
robots
  robot rojo
  variables
    flores:numero
    av:numero
    id:numero
  comenzar
    RecibirMensaje(id,rF)
    av:=PosAv
    flores:=0
    repetir 96
      juntarF (flores)
      mover
    juntarF(flores)
    BloquearEsquina(av,98)
    mover
    juntarF(flores)
    BloquearEsquina (av,99)
    mover
    LiberarEsquina(av,98)
    juntarF(flores)
    mover
    LiberarEsquina(av,99)
    juntarF(flores)
    EnviarMensaje(id,rF)
    EnviarMensaje(flores,rF)
  fin
  robot azul
  variables
    papeles:numero
    ca:numero
    id:numero
  comenzar
    RecibirMensaje(id,rF)
    papeles:=0
    ca:=PosCa
    derecha
    juntarP(papeles)
    BloquearEsquina(2,ca)
    mover
    juntarP(papeles)    
    BloquearEsquina(3,ca)
    mover
    LiberarEsquina(2,ca)
    juntarP(papeles)
    mover
    LiberarEsquina(3,ca)
    repetir 96
      juntarP(papeles)
      mover
    juntarP(papeles)
    EnviarMensaje(id,rF)
    EnviarMensaje(papeles,rF)
  fin
  robot fiscalizador
  variables
    id:numero
    p,f:numero
    aux:numero {!!!}
  comenzar
    IDs
    f:=0
    p:=0
    repetir 4
      RecibirMensaje(id,*)
      si(id=1)
        RecibirMensaje(aux,r1)
        f:=f+aux
      sino
        si(id=2)
          RecibirMensaje(aux,r2)
          f:=f+aux
        sino
          si(id=3)
            RecibirMensaje(aux,a1)
            p:=p+aux
          sino
            RecibirMensaje(aux,a2)
            p:=p+aux
    si (f>p)
      Informar ('rojo',f)
    sino
      si(p>f)
        Informar('azul',p)
      sino
        Informar('empate',f)
  fin
variables
  r1,r2:rojo
  a1,a2:azul
  rF:fiscalizador
comenzar
  AsignarArea(r1,areaR1)
  AsignarArea(r1,areaR1B)
  AsignarArea(r1,esquina1)
  AsignarArea(r2,areaR2)
  AsignarArea(r2,areaR2B)
  AsignarArea(r2,esquina2)
  AsignarArea(a1,areaA1)
  AsignarArea(a1,areaA1B)
  AsignarArea(a1,esquina1)
  AsignarArea(a1,esquina2)
  AsignarArea(a2,areaA2)
  AsignarArea(a2,areaA2B)
  AsignarArea(a2,esquina1)
  AsignarArea(a2,esquina2)
  AsignarArea(rF,areaF)
  Iniciar(r1,2,1)
  Iniciar(r2,3,1)
  Iniciar(a1,1,98)
  Iniciar(a2,1,99)
  Iniciar(rF,1,1)
fin