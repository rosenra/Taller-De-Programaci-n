programa escondedor
areas
  area1: AreaP(1,1,1,1)
  area2: AreaP(2,2,2,2)
  area3: AreaP(3,3,3,3)
  areaE: AreaP(4,4,4,4)
  cuadrante: AreaC(10,10,13,13)
robots
  robot buscador
  variables
    ok:boolean
    av,ca:numero
    avIni,caIni:numero
    id:numero
    final:boolean
  comenzar
    RecibirMensaje(id,rE)
    ok:=F
    avIni:=PosAv
    caIni:=PosCa
    mientras (ok=F)& (final=F)
      Random(av,10,13)
      Random(ca,10,13)
      BloquearEsquina(av,ca)
      Pos(av,ca)
      si(HayFlorEnLaEsquina)
        ok:=V
      Pos(avIni,caIni)
      LiberarEsquina(av,ca)
      EnviarMensaje(id,rE)
      EnviarMensaje(ok,rE)
      RecibirMensaje(final,rE)
  fin
  robot escondedor
  variables
    id:numero
    ganador:numero
    ok:boolean
    ca,av:numero
    avIni,caIni:numero
  comenzar
    ok:=F
    avIni:=PosAv
    caIni:=PosCa
    Random(av,10,13)
    Random(ca,10,13)
    Pos(av,ca)
    depositarFlor
    Pos(avIni,caIni)
    EnviarMensaje(1,r1)
    EnviarMensaje(2,r2)
    EnviarMensaje(3,r3)
    mientras(ok=F)
      RecibirMensaje(id,*)
      si(id=1)
        RecibirMensaje(ok,r1)
      sino
        si(id=2)
          RecibirMensaje(ok,r2)
        sino
          RecibirMensaje(ok,r3)
      si(ok=V)
        ganador:=id
      si (id=1)
        EnviarMensaje(ok,r2)
        EnviarMensaje(ok,r3)
      sino
        si(id=2)
          EnviarMensaje(ok,r1)
          EnviarMensaje(ok,r3)
        sino
          EnviarMensaje(ok,r1)
          EnviarMensaje(ok,r2)
    Informar('el r ganador es',ganador)
  fin
variables
  r1,r2,r3:buscador
  rE:escondedor
comenzar
  AsignarArea(r1,area1)
  AsignarArea(r2,area2)
  AsignarArea(r3,area3)
  AsignarArea(rE,areaE)
  AsignarArea(r1,cuadrante)
  AsignarArea(r2,cuadrante)
  AsignarArea(r3,cuadrante)
  AsignarArea(rE,cuadrante)
  Iniciar(r1,1,1)
  Iniciar(r2,2,2)
  Iniciar(r3,3,3)
  Iniciar(rE,4,4)
fin